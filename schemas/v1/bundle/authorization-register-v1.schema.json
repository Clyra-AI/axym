{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axym.dev/schemas/v1/bundle/authorization-register-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle_id",
          "status",
          "source_product",
          "source_artifact_type",
          "source_artifact_id",
          "source_artifact_path",
          "verification",
          "linked_proof_refs"
        ],
        "properties": {
          "bundle_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["verified", "partial", "missing_link", "signature_failed", "schema_invalid"] },
          "source_product": { "type": "string", "minLength": 1 },
          "source_artifact_type": { "type": "string", "minLength": 1 },
          "source_artifact_id": { "type": "string", "minLength": 1 },
          "source_artifact_path": { "type": "string", "minLength": 1 },
          "source_version": { "type": "string" },
          "decision": { "type": "string" },
          "trace_id": { "type": "string" },
          "intent_digest": { "type": "string" },
          "policy_digest": { "type": "string" },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_valid"],
            "properties": {
              "status": { "type": "string" },
              "schema_valid": { "type": "boolean" },
              "signature_valid": { "type": "boolean" },
              "reason_codes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          },
          "approval_audit_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "credential_evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "action_outcome_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "linked_proof_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["record_id"],
              "properties": {
                "record_id": { "type": "string", "minLength": 1 },
                "record_hash": { "type": "string" },
                "record_type": { "type": "string" }
              }
            }
          },
          "gap_reason_codes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
