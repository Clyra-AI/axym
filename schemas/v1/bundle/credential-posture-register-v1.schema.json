{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axym.dev/schemas/v1/bundle/credential-posture-register-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle_id",
          "artifact_id",
          "status",
          "source_product",
          "source_artifact_path",
          "standing_credential_blocked",
          "jit_required",
          "proof_refs"
        ],
        "properties": {
          "bundle_id": { "type": "string", "minLength": 1 },
          "artifact_id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["jit_verified", "standing_blocked", "missing_binding", "ttl_missing", "scope_missing", "broker_missing", "issuer_missing"]
          },
          "source_product": { "type": "string", "minLength": 1 },
          "source_artifact_path": { "type": "string", "minLength": 1 },
          "standing_credential_blocked": { "type": "boolean" },
          "jit_required": { "type": "boolean" },
          "broker_source": { "type": "string" },
          "issuer": { "type": "string" },
          "ttl_seconds": { "type": "integer", "minimum": 0 },
          "scope": { "type": "string" },
          "binding_proof_ref": { "type": "string" },
          "action_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["record_id"],
              "properties": {
                "record_id": { "type": "string", "minLength": 1 },
                "record_hash": { "type": "string" },
                "record_type": { "type": "string" }
              }
            }
          },
          "gap_reason_codes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
